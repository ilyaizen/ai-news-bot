[Unit]
Description=AI News Discord Bot
Documentation=https://github.com/ilyaizen/ai-news-bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ainewsbot
Group=ainewsbot
WorkingDirectory=/srv/apps/ai-news-bot
EnvironmentFile=-/srv/apps/ai-news-bot/.env
ExecCondition=/srv/apps/ai-news-bot/scripts/preflight.sh
ExecStart=/srv/apps/ai-news-bot/venv/bin/python /srv/apps/ai-news-bot/main.py
Restart=always
RestartSec=15
TimeoutStopSec=30
KillSignal=SIGINT

# Hardening. Needs outbound HTTPS and write access only to its own app dir.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/apps/ai-news-bot
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
